# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Server Configuration
PORT=3001
API_HOST=0.0.0.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Security Configuration
# IMPORTANT: Change this to a strong, random secret key in production!
# Use: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# CORS Configuration
# Comma-separated list of allowed origins (e.g. "http://localhost:3000,https://yourdomain.com")
# Leave empty to allow all origins (NOT recommended for production)
CORS_ORIGIN=""

# Payment Gateway Configuration
PAYMENT_GATEWAY=midtrans

# Midtrans Configuration
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_PRODUCTION=false

# Xendit Configuration (if using Xendit)
XENDIT_SECRET_KEY="your-xendit-secret-key"
XENDIT_API_KEY="your-xendit-api-key"

# Webhook Configuration
WEBHOOK_SECRET="your-webhook-secret-for-signature-verification"
WEBHOOK_URL=https://your-domain.com/api/webhooks/payment

# Environment
NODE_ENV=development

# File Storage Configuration
# Uploaded assets (company logo, launcher background) are stored locally under
# `uploads/` by default — correct for a single-server/LAN deployment.
# Set S3_BUCKET to switch to S3-compatible object storage instead (required for
# cloud-hosted deployments with multiple instances or an ephemeral filesystem).
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, or self-hosted MinIO.
# S3_BUCKET="your-bucket-name"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"  # omit for real AWS S3
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# S3_FORCE_PATH_STYLE=false  # set true for MinIO/some self-hosted providers
