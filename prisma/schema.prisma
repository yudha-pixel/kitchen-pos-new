generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String           @id @default(uuid()) @db.Uuid
  username      String           @unique
  full_name     String
  email         String?          @unique
  password_hash String
  phone         String?
  is_active     Boolean          @default(true)
  outlet_id     String?          @db.Uuid
  role_id       String           @db.Uuid
  preferences   Json?            @default("{}")
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  void_logs     OrderVoidLog[]
  voided_payments PaymentTransaction[]
  orders        Order[]
  outlet        Outlet?          @relation(fields: [outlet_id], references: [id])
  role          Role             @relation(fields: [role_id], references: [id])
  notifications Notification[]
  pettyCashExpenses PettyCash[]   @relation("PettyCashCreatedBy")

  @@index([outlet_id])
  @@index([role_id])
  @@map("profiles")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  is_system   Boolean          @default(false)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  profiles    Profile[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  module      String
  action      String
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  role_id      String     @db.Uuid
  permission_id String    @db.Uuid
  created_at   DateTime   @default(now())
  role         Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@index([permission_id])
  @@map("role_permissions")
}

model Category {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  color            String?
  categoryPrinters CategoryPrinter[]
  products         Product[]
  kitchenStationCategories KitchenStationCategory[]

  @@map("categories")
}

model ModifierGroup {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  is_required           Boolean                @default(false)
  max_selections        Int                    @default(1)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  modifiers             Modifier[]
  productModifierGroups ProductModifierGroup[]

  @@map("modifier_groups")
}

model ProductModifierGroup {
  id                String        @id @default(uuid()) @db.Uuid
  product_id        String        @db.Uuid
  modifier_group_id String        @db.Uuid
  created_at        DateTime      @default(now())
  modifierGroup     ModifierGroup @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, modifier_group_id])
  @@index([product_id])
  @@index([modifier_group_id])
  @@map("product_modifier_groups")
}

model Product {
  id                    String                 @id @default(uuid()) @db.Uuid
  category_id           String?                @db.Uuid
  name                  String
  price                 Float
  stock_quantity        Int                    @default(0)
  image_url             String?
  sku                   String?                @unique
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  description           String?
  is_active             Boolean                @default(true)
  outlet_id             String?                @db.Uuid
  hpp                   Float                  @default(0) // HPP/COGS calculated from recipe
  customerOrderItems    CustomerOrderItem[]
  order_items           OrderItem[]
  void_logs             OrderVoidLog[]
  productModifierGroups ProductModifierGroup[]
  recipes               Recipe[]
  category              Category?              @relation(fields: [category_id], references: [id])
  outlet                Outlet?                @relation(fields: [outlet_id], references: [id])

  @@index([category_id])
  @@index([name])
  @@index([sku])
  @@index([outlet_id])
  @@map("products")
}

model Modifier {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  price_extra       Float         @default(0)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  modifier_group_id String        @db.Uuid
  modifierGroup     ModifierGroup @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)

  @@index([modifier_group_id])
  @@map("modifiers")
}

model Order {
  id                     String              @id @default(uuid()) @db.Uuid
  cashier_id             String?             @db.Uuid
  customer_id            String?             @db.Uuid
  total_amount           Float
  payment_method         String?
  status                 String              @default("pending")
  created_at             DateTime            @default(now()) @db.Timestamptz(6)
  table_number           String?
  discount_amount        Float               @default(0)
  rounding_amount        Float               @default(0)
  notes                  String?
  customer_order_id      String?             @db.Uuid
  outlet_id              String?             @db.Uuid
  payment_transaction_id String?             @unique @db.Uuid
  items                  OrderItem[]
  void_logs              OrderVoidLog[]
  cashier                Profile?            @relation(fields: [cashier_id], references: [id])
  customer               Customer?           @relation("CustomerOrders", fields: [customer_id], references: [id])
  customerOrder          CustomerOrder?      @relation(fields: [customer_order_id], references: [id])
  outlet                 Outlet?             @relation(fields: [outlet_id], references: [id])
  paymentTransaction     PaymentTransaction?

  @@index([cashier_id])
  @@index([customer_id])
  @@index([status])
  @@index([created_at])
  @@index([table_number])
  @@index([outlet_id])
  @@index([customer_order_id])
  @@index([payment_transaction_id])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  order_id          String   @db.Uuid
  product_id        String?  @db.Uuid
  quantity          Int
  price_at_time     Float
  modifiers_applied Json?
  discount_item     Float    @default(0)
  split_group_id    String?
  created_at        DateTime @default(now())
  status            String   @default("pending")
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@index([split_group_id])
  @@index([status])
  @@map("order_items")
}

model OrderVoidLog {
  id         String   @id @default(uuid()) @db.Uuid
  order_id   String   @db.Uuid
  product_id String?  @db.Uuid
  quantity   Int
  reason     String
  cashier_id String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  cashier    Profile? @relation(fields: [cashier_id], references: [id])
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([cashier_id])
  @@index([created_at])
  @@map("order_void_logs")
}

model Printer {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  type             String
  ip_address       String?
  port             Int?
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  categoryPrinters CategoryPrinter[]

  @@map("printers")
}

model CategoryPrinter {
  id          String   @id @default(uuid()) @db.Uuid
  category_id String   @db.Uuid
  printer_id  String   @db.Uuid
  created_at  DateTime @default(now())
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
  printer     Printer  @relation(fields: [printer_id], references: [id], onDelete: Cascade)

  @@unique([category_id, printer_id])
  @@index([category_id])
  @@index([printer_id])
  @@map("category_printers")
}

model Outlet {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  code          String           @unique
  address       String?
  phone         String?
  is_active     Boolean          @default(true)
  delivery_fee  Float            @default(15000)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  orders        Order[]
  products      Product[]
  profiles      Profile[]
  tables        Table[]
  warehouses    Warehouse[]
  kitchenStations KitchenStation[]

  @@index([code])
  @@map("outlets")
}

model Warehouse {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  code        String            @unique
  outlet_id   String            @db.Uuid
  address     String?
  is_active   Boolean           @default(true)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  outlet      Outlet            @relation(fields: [outlet_id], references: [id])
  ingredients Ingredient[]
  transfersFrom StockTransfer[] @relation("WarehouseTransfersFrom")
  transfersTo   StockTransfer[] @relation("WarehouseTransfersTo")

  @@index([outlet_id])
  @@index([code])
  @@map("warehouses")
}

model Table {
  id             String          @id @default(uuid()) @db.Uuid
  table_number   String          @unique
  qr_code        String?
  is_active      Boolean         @default(true)
  status         String          @default("available") // available, occupied, dirty, reserved
  outlet_id      String?         @db.Uuid
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  customerOrders CustomerOrder[]
  outlet         Outlet?         @relation(fields: [outlet_id], references: [id])

  @@index([table_number])
  @@index([outlet_id])
  @@index([status])
  @@map("tables")
}

model CustomerOrder {
  id             String              @id @default(uuid()) @db.Uuid
  table_id       String              @db.Uuid
  customer_name  String?
  total_amount   Float
  // pending (awaiting staff) -> accepted (converted to Order, see `orders` below) -> cancelled
  status         String              @default("pending")
  // one of src/features/self-order/paymentMethods.ts's ids ('cashier', 'qris', ...)
  payment_method String?
  payment_status String              @default("unpaid")
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  items          CustomerOrderItem[]
  table          Table               @relation(fields: [table_id], references: [id])
  orders         Order[]

  @@index([table_id])
  @@index([status])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id                String        @id @default(uuid()) @db.Uuid
  order_id          String        @db.Uuid
  product_id        String        @db.Uuid
  quantity          Int
  price_at_time     Float
  modifiers_applied Json?
  created_at        DateTime      @default(now())
  order             CustomerOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@map("customer_order_items")
}

model PaymentTransaction {
  id             String    @id @default(uuid()) @db.Uuid
  order_id       String    @unique @db.Uuid
  gateway        String
  gateway_tx_id  String?   @unique
  amount         Float
  payment_method String
  status         String    @default("pending")
  qr_code        String?
  qr_expiry      DateTime?
  paid_at        DateTime?
  voided_at      DateTime?
  voided_by      String?   @db.Uuid
  void_reason    String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  order          Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  voided_by_user Profile?  @relation(fields: [voided_by], references: [id])

  @@index([order_id])
  @@index([gateway_tx_id])
  @@index([status])
  @@index([voided_by])
  @@map("payment_transactions")
}

model AppSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  
  // UI Settings
  card_style         String   @default("rounded")
  primary_color      String   @default("blue")
  theme_mode         String   @default("light")
  card_view          String   @default("grid")
  cart_position      String   @default("right-sidebar")
  layout_density     String   @default("spacious")
  
  // Store Settings
  store_name         String   @default("Kitchen POS Restaurant")
  store_phone        String   @default("+62 21 1234 5678")
  store_email        String   @default("info@kitchenpos.com")
  store_address      String   @default("Jl. Contoh No. 123, Jakarta Selatan")
  web_base_url       String?  @default("http://localhost:3000")
  timezone           String   @default("Asia/Jakarta")
  currency           String   @default("IDR")
  tax_rate           Float    @default(10)
  service_charge     Float    @default(0)
  
  // Receipt Settings
  receipt_header     String   @default("TERIMA KASIH")
  receipt_footer     String   @default("Silakan datang kembali")
  show_logo          Boolean  @default(true)
  show_table_number  Boolean  @default(true)
  show_cashier_name  Boolean  @default(true)
  printer_type       String   @default("bluetooth")
  paper_width        String   @default("80")
  
  // Shift Settings
  default_cash_float  Float    @default(500000)
  require_cash_float  String   @default("yes")
  require_reconciliation Boolean @default(true)
  show_cash_comparison Boolean @default(true)
  auto_report        Boolean  @default(true)
  
  // Inventory Settings
  min_stock_menu      Int      @default(5)
  min_stock_ingredient Int     @default(10)
  notify_low_stock   Boolean  @default(true)
  show_pos_warning   Boolean  @default(true)
  email_manager      Boolean  @default(true)
  auto_restock_enabled Boolean @default(false)
  
  // Security Settings
  manager_pin        String   @default("1234")
  require_pin_void   Boolean  @default(true)
  require_pin_refund Boolean  @default(true)
  require_pin_discount Boolean @default(true)
  require_pin_delete Boolean  @default(true)
  backup_frequency   String   @default("daily")
  default_login_redirect String @default("/apps")
  
  // Kitchen Settings
  main_course_route   String   @default("KDS Display 1")
  beverage_route     String   @default("Bar Station")
  dessert_route      String   @default("KDS Display 1")
  sound_notification Boolean  @default(true)
  auto_refresh       Boolean  @default(true)
  show_estimation    Boolean  @default(true)
  
  // Table Settings
  indoor_count       Int      @default(10)
  outdoor_count      Int      @default(8)
  vip_count          Int      @default(4)
  qr_auto_generate   Boolean  @default(true)
  areas              Json?    @default("[{\"id\":\"1\",\"name\":\"Indoor\",\"description\":\"Area dalam restoran\",\"count\":10},{\"id\":\"2\",\"name\":\"Outdoor\",\"description\":\"Area luar restoran\",\"count\":8},{\"id\":\"3\",\"name\":\"VIP\",\"description\":\"Area VIP khusus\",\"count\":4}]")
  
  // User Settings
  admin_count        Int      @default(1)
  cashier_count      Int      @default(2)
  waiter_count       Int      @default(3)
  require_2fa        Boolean  @default(false)

  // Self-Order Settings
  // Which payment methods the QR self-order flow offers. Ids only — each method's
  // type (counter vs online) is fixed in src/features/self-order/paymentMethods.ts
  // because it governs whether a guest can settle their own order.
  selforder_payment_methods Json?  @default("[\"cashier\"]")
  // 'review' = guest request sits in the staff queue until a cashier accepts it
  // into the kitchen (see POST /self-order/orders/:id/accept). 'auto' = accepted
  // immediately on submission and both cashier and kitchen are notified at once —
  // for busy periods where the manual review step is itself the bottleneck.
  selforder_routing         String @default("review")

  @@map("app_settings")
}

model Customer {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  phone             String   @unique
  email             String?
  tier              String   @default("bronze") // bronze, silver, gold, platinum
  points            Int      @default(0)
  total_spent       Float    @default(0)
  discount_percentage Float  @default(5)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  orders            Order[]  @relation("CustomerOrders")

  @@index([phone])
  @@index([tier])
  @@index([is_active])
  @@map("customers")
}

model Voucher {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  description       String?
  discount_type     String   // nominal, percentage
  discount_value    Float
  minimum_purchase  Float    @default(0)
  max_discount      Float?
  quota             Int      @default(100)
  used_count        Int      @default(0)
  valid_from        DateTime @default(now())
  valid_until       DateTime
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([code])
  @@index([is_active])
  @@index([valid_from])
  @@index([valid_until])
  @@map("vouchers")
}

model Employee {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  phone             String
  email             String?
  position          String   // cashier, chef, waiter, manager, etc.
  employment_type   String   @default("permanent") // permanent, freelance
  base_salary       Float    @default(0)
  hourly_rate       Float    @default(0)
  join_date         DateTime @default(now())
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  attendances       Attendance[]
  payrolls          Payroll[]

  @@index([phone])
  @@index([position])
  @@index([is_active])
  @@map("employees")
}

model Attendance {
  id                String   @id @default(uuid()) @db.Uuid
  employee_id       String   @db.Uuid
  check_in_time     DateTime @default(now())
  check_out_time    DateTime?
  photo_url         String?  // URL to selfie photo
  location_lat       Float?
  location_lng      Float?
  location_address   String?
  shift_type        String?  // morning, afternoon, night
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  employee          Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@index([check_in_time])
  @@map("attendances")
}

model Payroll {
  id                String   @id @default(uuid()) @db.Uuid
  employee_id       String   @db.Uuid
  period_start      DateTime
  period_end        DateTime
  base_salary       Float    @default(0)
  overtime_hours    Float    @default(0)
  overtime_pay      Float    @default(0)
  bonus             Float    @default(0)
  deduction         Float    @default(0)
  total_pay         Float    @default(0)
  status            String   @default("pending") // pending, approved, paid
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  employee          Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@index([period_start])
  @@index([period_end])
  @@index([status])
  @@map("payrolls")
}

model Ingredient {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  category        String?         @db.Text
  current_stock   Float           @default(0)
  unit            String
  min_stock       Float           @default(0)
  restock_quantity Float          @default(0)
  unit_price      Float           @default(0)
  supplier_id     String?         @db.Uuid
  ad_hoc_supplier String?         @db.Text
  ad_hoc_price    Float?          @default(0)
  warehouse_id    String?         @db.Uuid
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  supplier        Supplier?       @relation("IngredientSupplier", fields: [supplier_id], references: [id])
  warehouse       Warehouse?      @relation(fields: [warehouse_id], references: [id])
  recipes         Recipe[]
  stockAdjustmentLogs StockAdjustmentLog[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems   StockTransferItem[]
  stockRequests   StockRequest[]
  stockWriteOffs  StockWriteOff[]
  grnItems        GoodsReceivedNoteItem[]
  prItems         PurchaseRequisitionItem[]
  pettyCashExpenses PettyCash[]   @relation("PettyCashIngredient")

  @@index([name])
  @@index([supplier_id])
  @@index([warehouse_id])
  @@map("ingredients")
}

model StockTransfer {
  id              String            @id @default(uuid()) @db.Uuid
  transfer_number String            @unique
  from_warehouse_id String          @db.Uuid
  to_warehouse_id   String          @db.Uuid
  status          String            @default("pending") // pending, approved, rejected, completed, cancelled
  requested_by    String            @db.Uuid
  approved_by     String?
  approved_at     DateTime?
  notes           String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  from_warehouse  Warehouse         @relation("WarehouseTransfersFrom", fields: [from_warehouse_id], references: [id])
  to_warehouse    Warehouse         @relation("WarehouseTransfersTo", fields: [to_warehouse_id], references: [id])
  items           StockTransferItem[]

  @@index([from_warehouse_id])
  @@index([to_warehouse_id])
  @@index([status])
  @@index([transfer_number])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String        @id @default(uuid()) @db.Uuid
  transfer_id      String        @db.Uuid
  ingredient_id    String        @db.Uuid
  quantity         Float
  unit             String
  created_at       DateTime      @default(now())
  transfer         StockTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  ingredient       Ingredient    @relation(fields: [ingredient_id], references: [id])

  @@index([transfer_id])
  @@index([ingredient_id])
  @@map("stock_transfer_items")
}

model StockRequest {
  id                  String   @id @default(uuid()) @db.Uuid
  ingredient_id       String   @db.Uuid
  ingredient_name     String
  quantity_requested  Float
  unit                String
  notes               String?
  supplier_id         String?  @db.Uuid  // Preferred supplier
  proof_file          String?
  proof_file_name     String?
  
  // Multi-level approval fields
  status              String   @default("pending_supervisor") // pending_supervisor, pending_manager, pending_finance, approved, rejected, cancelled
  approval_level      Int      @default(1) // 1=supervisor, 2=manager, 3=finance
  
  // Supervisor approval
  supervisor_id       String?  @db.Uuid
  supervisor_name     String?
  supervisor_approved_at   DateTime?
  supervisor_notes   String?
  
  // Manager approval
  manager_id          String?  @db.Uuid
  manager_name        String?
  manager_approved_at     DateTime?
  manager_notes       String?
  
  // Finance approval
  finance_id          String?  @db.Uuid
  finance_name        String?
  finance_approved_at     DateTime?
  finance_notes       String?
  
  // Rejection
  rejected_by         String?  @db.Uuid
  rejected_by_name    String?
  rejected_at         DateTime?
  rejection_reason   String?
  rejection_level     Int?     // Which level rejected
  
  // Original fields
  requested_by        String   @db.Uuid
  requested_by_name   String
  requested_at        DateTime @default(now())
  
  // Relations
  quotation_requests  QuotationRequest[]
  ingredient          Ingredient @relation(fields: [ingredient_id], references: [id])
  supplier            Supplier? @relation("StockRequestSupplier", fields: [supplier_id], references: [id])
  
  @@index([status])
  @@index([approval_level])
  @@index([requested_by])
  @@map("stock_requests")
}

// Simplified Stock Approval Request for the Stock Approvals UI
model StockApprovalRequest {
  id              String   @id @default(uuid()) @db.Uuid
  request_number  String   @unique // Auto-increment string like #REQ-XXX
  type            String   // 'Stock In' or 'Stock Out'
  requester_name  String
  item_name       String
  quantity        Float
  unit            String
  status          String   @default("Pending") // 'Pending', 'Approved', 'Rejected'
  manager_notes   String?
  processed_at    DateTime?
  processed_by    String?
  evidence_image  String?  // Base64 encoded image for evidence
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([status])
  @@index([request_number])
  @@map("stock_approval_requests")
}

model PurchaseRequisition {
  id               String   @id @default(uuid()) @db.Uuid
  pr_number        String   @unique // Auto-increment like #PR-001
  status           String   @default("Pending Approval") // 'Pending Approval', 'Approved', 'Rejected', 'Converted to PO'
  requested_by     String
  total_estimated  Float
  notes            String?
  approved_at      DateTime?
  approved_by      String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  prItems          PurchaseRequisitionItem[]

  @@index([status])
  @@index([pr_number])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                    String   @id @default(uuid()) @db.Uuid
  purchase_requisition_id String  @db.Uuid
  ingredient_id         String   @db.Uuid
  ingredient_name       String
  quantity              Float
  unit                  String
  estimated_price       Float
  supplier_id           String?  @db.Uuid

  purchaseRequisition   PurchaseRequisition @relation(fields: [purchase_requisition_id], references: [id])
  ingredient            Ingredient @relation(fields: [ingredient_id], references: [id])

  @@index([purchase_requisition_id])
  @@index([ingredient_id])
  @@index([supplier_id])
  @@map("purchase_requisition_items")
}

model StockWriteOff {
  id                    String    @id @default(uuid()) @db.Uuid
  ingredient_id         String    @db.Uuid
  ingredient_name       String
  quantity_written_off  Float
  unit                  String
  reason                String
  notes                 String?
  proof_file            String
  proof_file_name       String
  status                String    @default("pending") // pending, approved, rejected
  requested_by          String    @db.Uuid
  requested_by_name     String
  approved_by           String?   @db.Uuid
  approved_by_name      String?
  rejected_by           String?   @db.Uuid
  rejected_by_name      String?
  rejection_reason      String?
  requested_at          DateTime  @default(now())
  approved_at           DateTime?
  rejected_at           DateTime?
  ingredient            Ingredient @relation(fields: [ingredient_id], references: [id])

  @@index([ingredient_id])
  @@index([status])
  @@map("stock_write_offs")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  type        String   // order_created, order_updated, table_status_changed, stock_low, transfer_requested, stock_request_approval, po_review, payment_due, etc.
  title       String
  message     String
  entity_id   String?  // Related entity ID
  entity_type String?  // stock_request, purchase_order, invoice
  data        Json?
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())
  user        Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@index([type])
  @@index([created_at])
  @@map("notifications")
}

model Recipe {
  id                String     @id @default(uuid()) @db.Uuid
  menu_item_id      String     @db.Uuid
  ingredient_id     String     @db.Uuid
  quantity_required Float
  unit              String?
  created_at        DateTime   @default(now())
  ingredient        Ingredient @relation(fields: [ingredient_id], references: [id])
  product           Product    @relation(fields: [menu_item_id], references: [id])

  @@index([menu_item_id])
  @@index([ingredient_id])
  @@map("recipes")
}

model Supplier {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  phone           String
  email           String?
  address         String?
  payment_terms   String?        @default("net 30") // Default payment terms
  tax_id          String?        // NPWP for Indonesia
  pic_name        String?        // Contact Person name
  pic_mobile      String?        // Contact Person mobile/WhatsApp
  category        String?        // Supply category (e.g., Dairy & Cheese, Meat, Dry Goods, Vegetables)
  moq_amount      Decimal?       @db.Decimal(15, 2) // Minimum Order Quantity (nominal)
  moq_unit        String?        // MOQ unit (e.g., "Rp", "kg", "pcs")
  performance_notes String?      @db.Text // Vendor performance notes (delivery quality, timeliness, etc.)
  is_active       Boolean        @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  ingredients     Ingredient[]   @relation("IngredientSupplier")
  purchaseOrders  PurchaseOrder[]
  quotations      Quotation[]
  invoices        Invoice[]
  stockRequests   StockRequest[] @relation("StockRequestSupplier")
  goodsReceivedNotes GoodsReceivedNote[]

  @@index([name])
  @@index([is_active])
  @@index([category])
  @@map("suppliers")
}

model PurchaseOrder {
  id                String   @id @default(uuid()) @db.Uuid
  po_number         String   @unique
  quotation_id      String?  @db.Uuid  // Link to selected quotation
  supplier_id       String   @db.Uuid
  status            String   @default("draft") // draft, sent, acknowledged, partially_received, received, cancelled
  
  // PO details
  order_date        DateTime @default(now())
  expected_delivery DateTime?
  payment_terms     String?  // net 30, net 60, etc.
  subtotal          Float
  tax               Float    @default(0)
  total             Float
  notes             String?
  
  // Review & Send
  reviewed_by       String?  @db.Uuid
  reviewed_at       DateTime?
  sent_at           DateTime?
  acknowledged_at   DateTime?
  
  // Items
  items             PurchaseOrderItem[]
  
  // Relations
  quotation         Quotation? @relation(fields: [quotation_id], references: [id])
  supplier          Supplier @relation(fields: [supplier_id], references: [id])
  goodsReceivedNotes GoodsReceivedNote[]
  
  @@index([status])
  @@index([po_number])
  @@index([supplier_id])
  @@map("purchase_orders")
}

// Purchase Order Items (support multiple items per PO)
model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  purchase_order_id String  @db.Uuid
  ingredient_id   String   @db.Uuid
  ingredient_name String
  quantity        Float
  unit            String
  unit_price      Float
  total_price     Float
  
  purchase_order  PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  ingredient      Ingredient    @relation(fields: [ingredient_id], references: [id])
  
  @@index([purchase_order_id])
  @@index([ingredient_id])
  @@map("purchase_order_items")
}

// Quotation Request
model QuotationRequest {
  id              String   @id @default(uuid()) @db.Uuid
  stock_request_id String  @db.Uuid
  status          String   @default("open") // open, closed, cancelled
  sent_at         DateTime @default(now())
  closed_at       DateTime?
  notes           String?
  
  stock_request   StockRequest @relation(fields: [stock_request_id], references: [id])
  quotations      Quotation[]
  
  @@index([status])
  @@index([stock_request_id])
  @@map("quotation_requests")
}

// Quotation from Supplier
model Quotation {
  id                  String   @id @default(uuid()) @db.Uuid
  quotation_request_id String  @db.Uuid
  supplier_id         String   @db.Uuid
  status              String   @default("received") // received, selected, rejected
  
  // Quotation details
  quoted_price        Float
  quoted_unit         String
  delivery_date       DateTime?
  payment_terms       String?  // net 30, net 60, etc.
  valid_until         DateTime?
  notes               String?
  received_at         DateTime @default(now())
  
  // Selection
  selected_at         DateTime?
  selected_by         String?  @db.Uuid
  selected_by_name    String?
  
  quotation_request   QuotationRequest @relation(fields: [quotation_request_id], references: [id])
  supplier            Supplier @relation(fields: [supplier_id], references: [id])
  purchaseOrders      PurchaseOrder[]
  
  @@index([status])
  @@index([quotation_request_id])
  @@index([supplier_id])
  @@map("quotations")
}

// Goods Received Note
model GoodsReceivedNote {
  id              String   @id @default(uuid()) @db.Uuid
  grn_number      String   @unique
  purchase_order_id String  @db.Uuid
  supplier_id     String   @db.Uuid
  status          String   @default("pending") // pending, quality_check, completed, cancelled
  
  // Receiving details
  received_date   DateTime @default(now())
  received_by     String   @db.Uuid
  received_by_name String
  delivery_note   String?  // Supplier's delivery note number
  
  // Quality check
  quality_checked_by String?  @db.Uuid
  quality_checked_at DateTime?
  quality_notes   String?
  
  // Items
  items           GoodsReceivedNoteItem[]
  
  // Relations
  purchase_order  PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  supplier        Supplier @relation(fields: [supplier_id], references: [id])
  invoices        Invoice[]
  
  @@index([status])
  @@index([grn_number])
  @@index([purchase_order_id])
  @@map("goods_received_notes")
}

// GRN Items with quality check
model GoodsReceivedNoteItem {
  id              String   @id @default(uuid()) @db.Uuid
  grn_id          String   @db.Uuid
  ingredient_id   String   @db.Uuid
  ingredient_name String
  
  // Ordered vs Received
  ordered_qty     Float
  received_qty    Float
  unit            String
  
  // Quality check
  quality_status  String   @default("pending") // pending, approved, rejected
  rejection_reason String?
  batch_number    String?
  expiry_date     DateTime?
  
  // Stock update
  stock_updated   Boolean  @default(false)
  
  grn             GoodsReceivedNote @relation(fields: [grn_id], references: [id])
  ingredient      Ingredient @relation(fields: [ingredient_id], references: [id])
  
  @@index([grn_id])
  @@index([ingredient_id])
  @@map("grn_items")
}

// Supplier Invoice
model Invoice {
  id              String   @id @default(uuid()) @db.Uuid
  invoice_number  String   @unique
  grn_id          String   @db.Uuid
  supplier_id     String   @db.Uuid
  status          String   @default("pending") // pending, verified, partially_paid, paid, overdue
  
  // Invoice details
  invoice_date    DateTime
  due_date        DateTime
  subtotal        Float
  tax             Float    @default(0)
  total           Float
  payment_terms   String?  // net 30, net 60, etc.
  notes           String?
  
  // Verification
  verified_by     String?  @db.Uuid
  verified_at     DateTime?
  
  // Relations
  grn             GoodsReceivedNote @relation(fields: [grn_id], references: [id])
  supplier        Supplier @relation(fields: [supplier_id], references: [id])
  payments        Payment[]
  
  @@index([status])
  @@index([invoice_number])
  @@index([supplier_id])
  @@index([due_date])
  @@map("invoices")
}

// Payment
model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  invoice_id      String   @db.Uuid
  supplier_id     String   @db.Uuid
  status          String   @default("pending") // pending, completed, cancelled
  
  // Payment details
  payment_date    DateTime
  amount          Float
  payment_method  String   // transfer, cash, check
  reference_number String?
  notes           String?
  
  // Processing
  processed_by    String?  @db.Uuid
  processed_at    DateTime?
  
  // Relations
  invoice         Invoice @relation(fields: [invoice_id], references: [id])
  
  @@index([status])
  @@index([invoice_id])
  @@index([supplier_id])
  @@index([payment_date])
  @@map("payments")
}

// Approval Workflow Configuration
model ApprovalWorkflow {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  level           Int      // 1, 2, 3
  role_id         String   @db.Uuid
  role_name       String
  is_active       Boolean  @default(true)
  
  @@index([level])
  @@index([role_id])
  @@map("approval_workflows")
}

model StockAdjustmentLog {
  id              String   @id @default(uuid()) @db.Uuid
  ingredient_id   String   @db.Uuid
  previous_stock  Float
  new_stock       Float
  adjustment_type String   // 'manual', 'purchase', 'consumption', 'restock', 'void'
  reason          String?
  user_id         String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  ingredient      Ingredient @relation(fields: [ingredient_id], references: [id])

  @@index([ingredient_id])
  @@index([user_id])
  @@index([created_at])
  @@map("stock_adjustment_logs")
}

// OCR Scan Model for receipt/document scanning
model OcrScan {
  id          String   @id @default(uuid()) @db.Uuid
  scan_type   String   // 'receipt', 'supplier_note', 'menu', 'barcode'
  image_url   String
  extracted_text Json?
  extracted_data Json? // Structured data extracted from OCR
  status      String   @default("pending") // 'pending', 'processing', 'completed', 'failed'
  error_message String?
  user_id     String?  @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([user_id])
  @@index([scan_type])
  @@index([status])
  @@index([created_at])
  @@map("ocr_scans")
}

// Kitchen Station Model for routing orders to specific stations
model KitchenStation {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique // 'BAR', 'HOT_KITCHEN', 'COLD_KITCHEN', 'DESSERT'
  description String?
  is_active   Boolean  @default(true)
  outlet_id   String?  @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  outlet      Outlet?  @relation(fields: [outlet_id], references: [id])
  menuCategories KitchenStationCategory[]

  @@index([outlet_id])
  @@index([code])
  @@map("kitchen_stations")
}

// Junction table for KitchenStation and Category
model KitchenStationCategory {
  id                String   @id @default(uuid()) @db.Uuid
  kitchen_station_id String   @db.Uuid
  category_id       String   @db.Uuid
  kitchen_station   KitchenStation @relation(fields: [kitchen_station_id], references: [id], onDelete: Cascade)
  category          Category     @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([kitchen_station_id, category_id])
  @@index([kitchen_station_id])
  @@index([category_id])
  @@map("kitchen_station_categories")
}

// Database Backup Model
model DatabaseBackup {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String
  file_path   String
  file_size   BigInt
  backup_type String   // 'manual', 'scheduled'
  status      String   @default("completed") // 'pending', 'completed', 'failed'
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now())
  notes       String?

  @@index([backup_type])
  @@index([status])
  @@index([created_at])
  @@map("database_backups")
}

// Audit Log Model for tracking sensitive operations
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String?  @db.Uuid
  action      String   // 'create', 'update', 'delete', 'void', 'discount', 'price_change'
  entity_type String   // 'order', 'menu_item', 'ingredient', 'user', etc.
  entity_id   String?
  old_value   Json?
  new_value   Json?
  ip_address  String?
  user_agent  String?
  description String?
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([action])
  @@index([entity_type])
  @@index([created_at])
  @@map("audit_logs")
}

// Petty Cash Model for tracking small cash expenses
model PettyCash {
  id              String   @id @default(uuid()) @db.Uuid
  amount          Float
  description     String   @db.Text
  category        String?  // 'ad_hoc_purchase', 'operational', 'misc', etc.
  receipt_url     String?  // URL to receipt image
  expense_date    DateTime @default(now())
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Optional relation to ingredient if from ad-hoc purchase
  ingredient_id   String?  @db.Uuid
  ingredient      Ingredient? @relation("PettyCashIngredient", fields: [ingredient_id], references: [id])
  
  // Optional relation to shift if tracked per shift
  shift_id        String?  @db.Uuid
  
  created_by_user Profile?  @relation("PettyCashCreatedBy", fields: [created_by], references: [id])

  @@index([created_by])
  @@index([expense_date])
  @@index([ingredient_id])
  @@index([shift_id])
  @@map("petty_cash")
}
