generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String         @id @default(uuid()) @db.Uuid
  username      String         @unique
  role          String         @default("cashier")
  password_hash String
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  outlet_id     String?        @db.Uuid
  void_logs     OrderVoidLog[]
  orders        Order[]
  outlet        Outlet?        @relation(fields: [outlet_id], references: [id])

  @@index([outlet_id])
  @@map("profiles")
}

model Category {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  color            String?
  categoryPrinters CategoryPrinter[]
  products         Product[]

  @@map("categories")
}

model ModifierGroup {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  is_required           Boolean                @default(false)
  max_selections        Int                    @default(1)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  modifiers             Modifier[]
  productModifierGroups ProductModifierGroup[]

  @@map("modifier_groups")
}

model ProductModifierGroup {
  id                String        @id @default(uuid()) @db.Uuid
  product_id        String        @db.Uuid
  modifier_group_id String        @db.Uuid
  created_at        DateTime      @default(now())
  modifierGroup     ModifierGroup @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, modifier_group_id])
  @@index([product_id])
  @@index([modifier_group_id])
  @@map("product_modifier_groups")
}

model Product {
  id                    String                 @id @default(uuid()) @db.Uuid
  category_id           String?                @db.Uuid
  name                  String
  price                 Float
  stock_quantity        Int                    @default(0)
  image_url             String?
  sku                   String?                @unique
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  description           String?
  is_active             Boolean                @default(true)
  outlet_id             String?                @db.Uuid
  customerOrderItems    CustomerOrderItem[]
  order_items           OrderItem[]
  void_logs             OrderVoidLog[]
  productModifierGroups ProductModifierGroup[]
  category              Category?              @relation(fields: [category_id], references: [id])
  outlet                Outlet?                @relation(fields: [outlet_id], references: [id])

  @@index([category_id])
  @@index([name])
  @@index([sku])
  @@index([outlet_id])
  @@map("products")
}

model Modifier {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  price_extra       Float         @default(0)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  modifier_group_id String        @db.Uuid
  modifierGroup     ModifierGroup @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)

  @@index([modifier_group_id])
  @@map("modifiers")
}

model Order {
  id                     String              @id @default(uuid()) @db.Uuid
  cashier_id             String?             @db.Uuid
  total_amount           Float
  payment_method         String
  status                 String              @default("pending")
  created_at             DateTime            @default(now()) @db.Timestamptz(6)
  table_number           String?
  discount_amount        Float               @default(0)
  rounding_amount        Float               @default(0)
  notes                  String?
  customer_order_id      String?             @db.Uuid
  outlet_id              String?             @db.Uuid
  payment_transaction_id String?             @unique @db.Uuid
  items                  OrderItem[]
  void_logs              OrderVoidLog[]
  cashier                Profile?            @relation(fields: [cashier_id], references: [id])
  customerOrder          CustomerOrder?      @relation(fields: [customer_order_id], references: [id])
  outlet                 Outlet?             @relation(fields: [outlet_id], references: [id])
  paymentTransaction     PaymentTransaction?

  @@index([cashier_id])
  @@index([status])
  @@index([created_at])
  @@index([table_number])
  @@index([outlet_id])
  @@index([customer_order_id])
  @@index([payment_transaction_id])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  order_id          String   @db.Uuid
  product_id        String?  @db.Uuid
  quantity          Int
  price_at_time     Float
  modifiers_applied Json?
  discount_item     Float    @default(0)
  split_group_id    String?
  created_at        DateTime @default(now())
  status            String   @default("pending")
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@index([split_group_id])
  @@index([status])
  @@map("order_items")
}

model OrderVoidLog {
  id         String   @id @default(uuid()) @db.Uuid
  order_id   String   @db.Uuid
  product_id String?  @db.Uuid
  quantity   Int
  reason     String
  cashier_id String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  cashier    Profile? @relation(fields: [cashier_id], references: [id])
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([cashier_id])
  @@index([created_at])
  @@map("order_void_logs")
}

model Printer {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  type             String
  ip_address       String?
  port             Int?
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  categoryPrinters CategoryPrinter[]

  @@map("printers")
}

model CategoryPrinter {
  id          String   @id @default(uuid()) @db.Uuid
  category_id String   @db.Uuid
  printer_id  String   @db.Uuid
  created_at  DateTime @default(now())
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
  printer     Printer  @relation(fields: [printer_id], references: [id], onDelete: Cascade)

  @@unique([category_id, printer_id])
  @@index([category_id])
  @@index([printer_id])
  @@map("category_printers")
}

model Outlet {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  code       String    @unique
  address    String?
  phone      String?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  orders     Order[]
  products   Product[]
  profiles   Profile[]
  tables     Table[]

  @@index([code])
  @@map("outlets")
}

model Table {
  id             String          @id @default(uuid()) @db.Uuid
  table_number   String          @unique
  qr_code        String?
  is_active      Boolean         @default(true)
  outlet_id      String?         @db.Uuid
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  customerOrders CustomerOrder[]
  outlet         Outlet?         @relation(fields: [outlet_id], references: [id])

  @@index([table_number])
  @@index([outlet_id])
  @@map("tables")
}

model CustomerOrder {
  id             String              @id @default(uuid()) @db.Uuid
  table_id       String              @db.Uuid
  customer_name  String?
  total_amount   Float
  status         String              @default("pending")
  payment_method String?
  payment_status String              @default("unpaid")
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  items          CustomerOrderItem[]
  table          Table               @relation(fields: [table_id], references: [id])
  orders         Order[]

  @@index([table_id])
  @@index([status])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id                String        @id @default(uuid()) @db.Uuid
  order_id          String        @db.Uuid
  product_id        String        @db.Uuid
  quantity          Int
  price_at_time     Float
  modifiers_applied Json?
  created_at        DateTime      @default(now())
  order             CustomerOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@map("customer_order_items")
}

model PaymentTransaction {
  id             String    @id @default(uuid()) @db.Uuid
  order_id       String    @unique @db.Uuid
  gateway        String
  gateway_tx_id  String?   @unique
  amount         Float
  payment_method String
  status         String    @default("pending")
  qr_code        String?
  qr_expiry      DateTime?
  paid_at        DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  order          Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([gateway_tx_id])
  @@index([status])
  @@map("payment_transactions")
}

model AppSettings {
  id             String   @id @default(uuid()) @db.Uuid
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  card_style     String   @default("rounded")
  primary_color  String   @default("blue")
  theme_mode     String   @default("light")
  card_view      String   @default("grid")
  cart_position  String   @default("right-sidebar")
  layout_density String   @default("spacious")

  @@map("app_settings")
}

model Ingredient {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  current_stock Float     @default(0)
  unit          String
  min_stock     Float     @default(0)
  unit_price    Float     @default(0)
  supplier_id   String?   @db.Uuid
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  supplier      Supplier? @relation(fields: [supplier_id], references: [id])
  recipes       Recipe[]

  @@index([name])
  @@index([supplier_id])
  @@map("ingredients")
}

model Recipe {
  id                String     @id @default(uuid()) @db.Uuid
  menu_item_id      String     @db.Uuid
  ingredient_id     String     @db.Uuid
  quantity_required Float
  unit              String?
  created_at        DateTime   @default(now())
  ingredient        Ingredient @relation(fields: [ingredient_id], references: [id])

  @@index([menu_item_id])
  @@index([ingredient_id])
  @@map("recipes")
}

model Supplier {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  phone       String
  email       String?
  address     String?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  ingredients Ingredient[]

  @@index([name])
  @@map("suppliers")
}
